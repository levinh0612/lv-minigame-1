{
  "name": "tiem-banh-matcha",
  "private": true,
  "version": "2.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "capture": "npm run build && node scripts/capture.mjs",
    "storybook": "vite --open /storybook.html",
    "db:init": "node --env-file=.env.local scripts/db-init.mjs",
    "themes": "node scripts/gen-themes.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "three": "^0.186.1",
    "web-push": "^3.6.7"
  }
}
